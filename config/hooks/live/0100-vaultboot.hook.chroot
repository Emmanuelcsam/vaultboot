#!/bin/sh
set -eu

# Compressed RAM swap avoids writing ordinary swap to the USB stick.
cat > /etc/default/zramswap <<'EOF'
ALGO=lz4
PERCENT=50
PRIORITY=100
EOF
mkdir -p /etc/systemd/journald.conf.d /etc/NetworkManager/conf.d
cat > /etc/systemd/journald.conf.d/vaultboot.conf <<'EOF'
[Journal]
Storage=volatile
RuntimeMaxUse=16M
EOF
cat > /etc/NetworkManager/conf.d/vaultboot.conf <<'EOF'
[ifupdown]
managed=true
EOF
systemctl enable NetworkManager.service lightdm.service
