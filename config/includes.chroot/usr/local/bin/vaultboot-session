#!/bin/sh
# Keep window management alive even when setup needs attention.
export XDG_CURRENT_DESKTOP=Vaultboot
export XDG_SESSION_DESKTOP=vaultboot
export DESKTOP_SESSION=vaultboot
xsetroot -solid '#181820'
openbox --config-file /etc/xdg/openbox/vaultboot-rc.xml &
window_manager=$!
trap 'kill "$window_manager" 2>/dev/null || true' EXIT HUP INT TERM
vaultboot session
# A recoverable supervisor error still leaves system-menu / terminal keys usable.
wait "$window_manager"
